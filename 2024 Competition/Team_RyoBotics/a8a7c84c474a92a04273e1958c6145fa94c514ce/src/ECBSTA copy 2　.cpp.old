    size_t ECBSTA::getOrCreateNodeId(const NodeIdentity &identity)
    {
        if (hasNodeIdentity(identity))
        {
            return node_id_map[identity];
        }
        size_t new_id = next_node_id++;
        node_id_map[identity] = new_id;
        return new_id;
    }

    Node *ECBSTA::getOrCreateNode(const NodeIdentity &identity)
    {
        size_t id = getOrCreateNodeId(identity);
        auto it = nodes.find(id);
        if (it != nodes.end())
        {
            return it->second;
        }

        // 新しいノードを作成
        Node *new_node = new Node();
        new_node->id = id;
        new_node->constraints = identity.constraints;
        new_node->assignment = identity.assignment;
        nodes[id] = new_node;
        return new_node;
    }

    bool ECBSTA::hasNodeIdentity(const NodeIdentity &identity) const
    {
        return node_id_map.find(identity) != node_id_map.end();
    }

    void ECBSTA::initialize()
    {
        w = 1.3;
        min_lb = std::numeric_limits<double>::max();
        r = 0.0;
        // メモリ解放
        for (auto &[id, node] : nodes)
        {
            delete node;
        }
        nodes.clear();
        node_id_map.clear();
        next_node_id = 0;
    }

    Node *ECBSTA::createRootNode(const Assignment &initial_assignment)
    {
        // 空の制約セットと初期割り当てでNodeIdentityを作成
        NodeIdentity root_identity{
            std::unordered_set<Constraint, ConstraintHash, ConstraintEqual>(),
            initial_assignment};
        if (hasNodeIdentity(root_identity))
        {
            return nullptr;
        }

        // ノードを取得または作成
        Node *root = getOrCreateNode(root_identity);
        root->root = true;
        root->I.clear();
        root->O.clear();
        root->cost = calculateAssignmentCost(initial_assignment, cost_matrix);

        return root;
    }
}